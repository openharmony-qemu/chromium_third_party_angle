diff a/src/tests/gl_tests/PixelLocalStorageTest.cpp b/src/tests/gl_tests/PixelLocalStorageTest.cpp	(rejected hunks)
@@ -845,6 +845,92 @@ TEST_P(PixelLocalStorageTest, R32_noncoherent)
     doR32Test(/*noncoherent=*/true);
